# Server-side only. Copy to apps/web/.env.local for local development (pnpm dev).
# API_INTERNAL_URL is also where next dev proxies the browser's /api/* calls.
API_INTERNAL_URL=http://localhost:4000
SITE_URL=http://localhost:3000
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/under30ss
REVALIDATE_SECRET=change-me-random-16+

# Optional: max seconds a public page may stay stale if an on-demand revalidate is lost (default 300)
PUBLIC_REVALIDATE_SECONDS=300

# Optional: IANA time zone used to show dates in the admin (default Asia/Ho_Chi_Minh)
ADMIN_TIME_ZONE=Asia/Ho_Chi_Minh
