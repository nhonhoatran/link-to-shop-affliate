{
  "name": "@under30ss/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Ứng dụng nhập nháp bộ sưu tập từ ảnh bằng Codex",
  "author": "Under30ss",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "check-package": "node scripts/check-package.mjs",
    "package": "pnpm build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@under30ss/shared": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "vn.under30ss.importer",
    "productName": "Under30ss Importer",
    "asar": true,
    "asarUnpack": ["**/node_modules/sharp/**", "**/node_modules/@img/**"],
    "directories": { "output": "dist/package" },
    "files": ["dist/main/**", "dist/preload/**", "dist/renderer/**", "package.json"],
    "win": { "target": "portable", "signAndEditExecutable": false, "artifactName": "under30ss-importer-${version}-${arch}.${ext}" }
  }
}
