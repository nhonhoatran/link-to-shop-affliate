# Local development (api run on host: pnpm --filter @under30ss/api dev)
NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://localhost:27017/under30ss
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-chars
SESSION_MAX_AGE_HOURS=168
# Cookie "Secure" flag. Unset = true when NODE_ENV=production, false otherwise.
# Plain-HTTP setups (local compose) must set false or login silently fails; production must run behind HTTPS.
SESSION_COOKIE_SECURE=false

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=under30ss
S3_ACCESS_KEY=change-me-access-key
S3_SECRET_KEY=change-me-secret-key-min-8
S3_FORCE_PATH_STYLE=true
# Browser-facing base URL of the bucket: RustFS directly in dev (anonymous read on public/*); Caddy /media in compose
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/under30ss

WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me-random-16+

UPLOAD_MAX_MB=10
# Hard cap for the upload limit editable in admin settings; Caddy rejects bodies larger than this + 1 MiB (multipart overhead).
UPLOAD_MAX_MB_CEILING=20
WEBP_QUALITY=82
IMAGE_MAX_EDGE_MODEL=1600
IMAGE_MAX_EDGE_ITEM=800

ADMIN_PAGE_SIZE_DEFAULT=20
ADMIN_PAGE_SIZE_MAX=100

ALLOWED_ORIGIN=http://localhost:3000,http://localhost:8080

# Optional (defaults shown). Site defaults apply only until settings are saved in admin.
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
# Failed logins per IP + email pair per window (strict: one attacker cannot lock the real owner out)
LOGIN_RATE_LIMIT_MAX_FAILURES=5
# Failed logins per email from all IPs combined per window (loose backstop for distributed guessing)
LOGIN_RATE_LIMIT_MAX_FAILURES_PER_EMAIL=50
# All login attempts per IP per window (stops one IP trying many emails)
LOGIN_RATE_LIMIT_MAX_ATTEMPTS_PER_IP=20
# Days a browser stays exempt from the per-email limit after a successful login (signed httpOnly device cookie)
LOGIN_DEVICE_COOKIE_MAX_AGE_DAYS=90
# Concurrent argon2 hash/verify operations (protects the shared thread pool)
ARGON2_MAX_CONCURRENCY=2
# Password checks allowed to wait for a free slot; more than this answers 503 "busy"
ARGON2_MAX_QUEUE=20
# /api/health gives up on the MongoDB ping after this long
HEALTH_CHECK_TIMEOUT_MS=2000
DEFAULT_SITE_NAME=Under30ss
DEFAULT_SEO_TITLE=Under30ss - Shop the look
DEFAULT_SEO_DESCRIPTION=
