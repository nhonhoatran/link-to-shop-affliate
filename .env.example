# Root example for docker compose (infra/docker-compose.yml). Copy to .env and change every secret.
# Values below are development defaults, not business constants.

# Public origin served by Caddy (no trailing slash)
SITE_URL=http://localhost:8080
CADDY_HTTP_PORT=8080

# MongoDB (internal network only)
MONGO_DB=under30ss

# RustFS (S3-compatible object storage, internal network only)
S3_BUCKET=under30ss
S3_ACCESS_KEY=change-me-access-key
S3_SECRET_KEY=change-me-secret-key-min-8
# Public URL of the bucket through Caddy: <SITE_URL>/media
MEDIA_PUBLIC_BASE_URL=http://localhost:8080/media

# API
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-chars
SESSION_MAX_AGE_HOURS=168
# Cookie "Secure" flag. This compose stack serves plain HTTP, so keep false locally.
# Behind HTTPS (SITE_ADDRESS is a domain) set true; a Secure cookie over HTTP means login never sticks.
SESSION_COOKIE_SECURE=false
REVALIDATE_SECRET=change-me-random-16+
ALLOWED_ORIGIN=http://localhost:8080
UPLOAD_MAX_MB=10
# Hard cap for the upload limit editable in admin settings; Caddy's request body limit is this + 1 MiB (multipart overhead)
UPLOAD_MAX_MB_CEILING=20
WEBP_QUALITY=82
IMAGE_MAX_EDGE_MODEL=1600
IMAGE_MAX_EDGE_ITEM=800
ADMIN_PAGE_SIZE_DEFAULT=20
ADMIN_PAGE_SIZE_MAX=100
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
# Failed logins per IP + email pair per window (strict)
LOGIN_RATE_LIMIT_MAX_FAILURES=5
# Failed logins per email from all IPs combined per window (loose backstop; keep well above the strict limit)
LOGIN_RATE_LIMIT_MAX_FAILURES_PER_EMAIL=50
# All login attempts per IP per window
LOGIN_RATE_LIMIT_MAX_ATTEMPTS_PER_IP=20
ARGON2_MAX_CONCURRENCY=2
# Password checks allowed to wait for a free slot; more than this answers 503 "busy"
ARGON2_MAX_QUEUE=20
HEALTH_CHECK_TIMEOUT_MS=2000
# Web: safety-net cache lifetime for public pages (seconds) if a revalidate call is ever lost
PUBLIC_REVALIDATE_SECONDS=300
# Web: IANA time zone for dates shown in admin
ADMIN_TIME_ZONE=Asia/Ho_Chi_Minh
# Site defaults, used only until settings are saved in admin
DEFAULT_SITE_NAME=Under30ss
DEFAULT_SEO_TITLE=Under30ss - Shop the look
DEFAULT_SEO_DESCRIPTION=

# Caddy: ":80" for HTTP, or a bare domain (e.g. shop.example.com) for automatic HTTPS
SITE_ADDRESS=:80
CADDY_HTTPS_PORT=8443
