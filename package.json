{
  "name": "under30ss",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:infra": "docker compose --env-file .env -f infra/docker-compose.yml up -d mongo rustfs-init",
    "dev": "pnpm --filter @under30ss/shared build && pnpm -r --parallel --filter @under30ss/api --filter @under30ss/web --filter @under30ss/shared dev",
    "build": "pnpm --filter @under30ss/shared build && pnpm --filter @under30ss/api build && pnpm --filter @under30ss/web build",
    "desktop:dev": "pnpm --filter @under30ss/desktop dev",
    "desktop:build": "pnpm --filter @under30ss/desktop build",
    "desktop:package": "pnpm --filter @under30ss/desktop package",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "test": "pnpm -r test",
    "e2e": "playwright test",
    "seed:samples": "pnpm --filter @under30ss/api seed:samples",
    "create-admin": "pnpm --filter @under30ss/api create-admin",
    "seed:demo": "pnpm --filter @under30ss/api seed:demo",
    "share": "node scripts/share/start-public-tunnel.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
