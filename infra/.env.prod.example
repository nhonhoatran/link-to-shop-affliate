# Production example for infra/docker-compose.prod.yml. Copy to .env.prod at the repo root (git-ignored) and replace every value.
# Optional tuning variables (upload limits, rate limits, ...) keep the defaults from .env.example when omitted.

# Public domain served by Caddy -> automatic HTTPS (DNS must point to this host, ports 80/443 open)
SITE_ADDRESS=shop.example.com
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
SITE_URL=https://shop.example.com
MEDIA_PUBLIC_BASE_URL=https://shop.example.com/media
ALLOWED_ORIGIN=https://shop.example.com

# MongoDB root account. Password must be URL-safe (letters, digits, - _ . ~): it is embedded in MONGODB_URI.
MONGO_ROOT_USER=under30ss_root
MONGO_ROOT_PASSWORD=change-me-url-safe-password
MONGO_DB=under30ss

# RustFS / S3
S3_BUCKET=under30ss
S3_ACCESS_KEY=change-me-access-key
S3_SECRET_KEY=change-me-secret-key-min-8

# Secrets
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-chars
REVALIDATE_SECRET=change-me-random-16+

# Backup (infra/backup/backup-mongo-and-bucket.sh)
BACKUP_DIR=/var/backups/under30ss
BACKUP_RETENTION_DAYS=14
